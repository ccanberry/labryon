
# Database Configuration
DATABASE_URL=postgresql+asyncpg://workflow_user:workflow_pass@localhost:5432/workflow_db
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
SECRET_KEY=dev-secret-key-not-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Configuration
DEBUG=FALSE
LOG_LEVEL=INFO
API_V1_STR=/v1

# Hugging Face Configuration
HF_TOKEN=hf_your_token_here

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Development Settings
FLOWER_PORT=5555
API_PORT=8000

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_NAME=knowledge-base

# LangFuse Configuration
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# Composo Configuration (Agent Output Evaluation)
COMPOSO_API_KEY=cp-your-composo-key-here
COMPOSO_ENABLED=false
COMPOSO_SCORE_THRESHOLD=0.7
COMPOSO_MAX_RETRIES=2

# Public API URL
# Replace with an HTTPS URL for webhook callbacks - use ngrok or a similar
# service to obtain a public URL.
PUBLIC_API_URL=https://your-subdomain.ngrok-free.dev

OPENAI_API_KEY=sk-proj-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here
MISTRAL_API_KEY=your-mistral-key-here

agent_verbose_logging=FALSE
